# Copy to .env.workspace (git-ignored) and fill in:  cp .env.workspace.example .env.workspace
# Used by docker-compose.workspace.yml

# REQUIRED
SESSION_SECRET=            # openssl rand -base64 48
PUBLIC_ORIGIN=https://draw.example.com   # the exact origin users open (CORS/CSRF allow-list)

# Optional
# ENCRYPTION_KEY=          # separate key for secrets at rest (AI keys); defaults to SESSION_SECRET
# WEB_PORT=8080
# MONGO_PORT=27017
# COOKIE_SECURE=false      # only when serving plain http on a trusted LAN...
# ALLOW_INSECURE_COOKIES=true   # ...and you must acknowledge it here

# Storage: local volume by default, or any S3-compatible bucket
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=excalidraw-workspace
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# AI (optional; workspace admins can also configure it in the UI)
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=

# Public API keys / MCP
# ENABLE_MCP=true
