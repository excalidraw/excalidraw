{
  "name": "@excalidraw/history",
  "version": "0.18.0",
  "type": "module",
  "types": "./dist/types/history/src/index.d.ts",
  "main": "./dist/prod/index.js",
  "module": "./dist/prod/index.js",
  "exports": {
    ".": {
      "excalidraw-source": "./src/index.ts",
      "types": "./dist/types/history/src/index.d.ts",
      "development": "./dist/dev/index.js",
      "production": "./dist/prod/index.js",
      "default": "./dist/prod/index.js"
    },
    "./*": {
      "excalidraw-source": "./src/*.js",
      "types": "./dist/types/history/src/*.d.ts",
      "development": "./dist/dev/index.js",
      "production": "./dist/prod/index.js",
      "default": "./dist/prod/index.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "description": "Excalidraw store, deltas and undo / redo history",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/types/history/src/index.d.ts",
        "development": "./dist/dev/index.js",
        "production": "./dist/prod/index.js",
        "default": "./dist/prod/index.js"
      },
      "./*": {
        "types": "./dist/types/history/src/*.d.ts",
        "development": "./dist/dev/index.js",
        "production": "./dist/prod/index.js",
        "default": "./dist/prod/index.js"
      }
    }
  },
  "license": "MIT",
  "keywords": [
    "excalidraw",
    "excalidraw-history",
    "undo",
    "redo"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie <= 11",
      "not op_mini all",
      "not safari < 12",
      "not kaios <= 2.5",
      "not edge < 79",
      "not chrome < 70",
      "not and_uc < 13",
      "not samsung < 10"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "bugs": "https://github.com/excalidraw/excalidraw/issues",
  "repository": "https://github.com/excalidraw/excalidraw",
  "scripts": {
    "gen:types": "rimraf types && tsc",
    "build:esm": "rimraf dist && node ../../scripts/buildBase.js && pnpm gen:types"
  },
  "dependencies": {
    "@excalidraw/common": "workspace:*",
    "@excalidraw/element": "workspace:*"
  }
}
