{
  "git": {
    "deploymentEnabled": {
      "master": true,
      "**": false
    }
  },
  "outputDirectory": "build",
  "installCommand": "yarn install",
  "redirects": [
    {
      "source": "/docs/introduction/development",
      "destination": "https://plus.excalidraw.com/docs/sdk/development",
      "permanent": true
    },
    {
      "source": "/docs/introduction/contributing",
      "destination": "https://plus.excalidraw.com/docs/sdk/contributing",
      "permanent": true
    },
    {
      "source": "/docs/codebase/:path*",
      "destination": "https://plus.excalidraw.com/docs/sdk/codebase/:path*",
      "permanent": true
    },
    {
      "source": "/docs/@excalidraw/excalidraw/API/:path*",
      "destination": "https://plus.excalidraw.com/docs/sdk/excalidraw/api/:path*",
      "permanent": true
    },
    {
      "source": "/docs/@excalidraw/excalidraw/:path*",
      "destination": "https://plus.excalidraw.com/docs/sdk/excalidraw/:path*",
      "permanent": true
    },
    {
      "source": "/docs/@excalidraw/mermaid-to-excalidraw/installation",
      "destination": "https://plus.excalidraw.com/docs/sdk/mermaid-to-excalidraw",
      "permanent": true
    },
    {
      "source": "/docs/@excalidraw/mermaid-to-excalidraw/:path*",
      "destination": "https://plus.excalidraw.com/docs/sdk/mermaid-to-excalidraw/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://plus.excalidraw.com/docs/sdk",
      "permanent": true
    }
  ]
}
