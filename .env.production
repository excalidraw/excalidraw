MODE="production"

# The endpoints below are still Excalidraw's, and collaboration is always on,
# so a live session and any `#json=` / `#room=` link a user opens DO reach them.
# Repointing them is a prerequisite for going live, not an optimisation.
#
# They are deliberately not blanked: an empty base URL turns
# `fetch(BACKEND_V2_POST)` into a same-origin POST of the user's scene, which is
# a quieter failure than an obviously foreign host.
#
# TODO(unobravo): point at the Unobravo share backend, then flip `shareLinks`
# in unobravo/config/features.ts.
VITE_APP_BACKEND_V2_GET_URL=https://json.excalidraw.com/api/v2/
VITE_APP_BACKEND_V2_POST_URL=https://json.excalidraw.com/api/v2/post/

VITE_APP_LIBRARY_URL=https://libraries.excalidraw.com
VITE_APP_LIBRARY_BACKEND=https://us-central1-excalidraw-room-persistence.cloudfunctions.net/libraries

VITE_APP_PLUS_LP=https://plus.excalidraw.com
VITE_APP_PLUS_APP=https://app.excalidraw.com

VITE_APP_AI_BACKEND=https://oss-ai.excalidraw.com

# Fallback only — the deployed app reads /ws-config.json at connect time
# instead (unobravo/collab/relayUrl.ts), since staging and production share one
# build. This value only applies to a local `vite build`/`vite preview`, or a
# deploy where the WS_SERVER_URL_PROD repository variable is unset.
# TODO(unobravo): once https://whiteboard-relay.unobravo.com is deployed (it is
# configured in the relay's Pulumi production stack but its DNS does not
# resolve yet, and its CORS allowlist is `.unobravo.com` only, so a
# Vercel-hosted origin would be refused), set it as the WS_SERVER_URL_PROD
# repository variable. See the relay section of unobravo/FORK.md.
VITE_APP_WS_SERVER_URL=https://whiteboard-relay.unobravo.com

# TODO(unobravo): swap for the Unobravo Firebase project before going live.
# Reached by any live collaboration session and by shared-link images.
VITE_APP_FIREBASE_CONFIG='{"apiKey":"AIzaSyAd15pYlMci_xIp9ko6wkEsDzAAA0Dn0RU","authDomain":"excalidraw-room-persistence.firebaseapp.com","databaseURL":"https://excalidraw-room-persistence.firebaseio.com","projectId":"excalidraw-room-persistence","storageBucket":"excalidraw-room-persistence.appspot.com","messagingSenderId":"654800341332","appId":"1:654800341332:web:4a692de832b55bd57ce0c1"}'

VITE_APP_ENABLE_TRACKING=false

# excalidraw-app/sentry.ts keys the DSN off the hostname and treats any
# *.vercel.app host as Excalidraw staging, so without this a preview deploy of
# this fork reports its errors — including scene URLs — to Excalidraw's Sentry.
VITE_APP_DISABLE_SENTRY=true

