{
  "name": "excalidraw-app",
  "version": "1.0.0",
  "private": true,
  "homepage": ".",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie <= 11",
      "not op_mini all",
      "not safari < 12",
      "not kaios <= 2.5",
      "not edge < 79",
      "not chrome < 70",
      "not and_uc < 13",
      "not samsung < 10"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "dependencies": {
    "@excalidraw/common": "workspace:*",
    "@excalidraw/element": "workspace:*",
    "@excalidraw/excalidraw": "workspace:*",
    "@excalidraw/math": "workspace:*",
    "@excalidraw/random-username": "1.1.0",
    "@sentry/browser": "9.0.1",
    "callsites": "4.2.0",
    "clsx": "1.1.1",
    "firebase": "11.3.1",
    "i18next-browser-languagedetector": "6.1.4",
    "idb-keyval": "6.0.3",
    "jotai": "2.11.0",
    "lodash.throttle": "4.1.1",
    "nanoid": "3.3.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "socket.io-client": "4.7.2",
    "uqr": "0.1.2",
    "vite-plugin-html": "3.2.2"
  },
  "prettier": "@excalidraw/prettier-config",
  "scripts": {
    "build:app:docker": "cross-env VITE_APP_DISABLE_SENTRY=true vite build",
    "build:app": "cross-env VITE_APP_GIT_SHA=$VERCEL_GIT_COMMIT_SHA cross-env VITE_APP_ENABLE_TRACKING=true vite build",
    "build:version": "node ../scripts/build-version.js",
    "build": "pnpm build:app && pnpm build:version",
    "start": "pnpm install && vite",
    "start:production": "pnpm build && pnpm serve",
    "serve": "pnpm exec http-server build -a localhost -p 5001 -o",
    "build:preview": "pnpm build && vite preview --port 5000"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "vite": "5.4.21",
    "vite-plugin-sitemap": "0.7.1",
    "workbox-window": "7.3.0"
  }
}
