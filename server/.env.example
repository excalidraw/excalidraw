# Copy to server/.env (never commit .env)
NODE_ENV=development
PORT=3100
HOST=127.0.0.1

# Local MongoDB (inspect with MongoDB Compass at this URI)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=excalidraw_workspace

# >= 32 random chars: openssl rand -base64 48
SESSION_SECRET=change-me-change-me-change-me-change-me
SESSION_TTL_DAYS=14
# Defaults to true only in production
# COOKIE_SECURE=false

# Object storage for images (local filesystem; S3-compatible planned)
STORAGE_PROVIDER=local
STORAGE_PATH=./storage
# STORAGE_PROVIDER=s3 stores images in any S3-compatible bucket (AWS S3, MinIO, Cloudflare R2, ...)
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=excalidraw-workspace
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PREFIX=
# S3_FORCE_PATH_STYLE=true
TRASH_RETENTION_DAYS=30

# Key for encrypting stored secrets (AI provider keys). Defaults to SESSION_SECRET.
# ENCRYPTION_KEY=

# AI (optional). Leave unset to keep AI off until a workspace admin configures a provider.
# Providers: openai | anthropic | gemini | openrouter | local (any OpenAI-compatible server, e.g. Ollama)
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
# AI_BASE_URL=http://127.0.0.1:11434/v1
# Allow admins to point "local" providers at private/LAN addresses (default: true outside production)
# AI_ALLOW_PRIVATE_BASE_URLS=true
# Daily request limits per workspace / per user (0 = unlimited)
AI_DEFAULT_WORKSPACE_LIMIT=200
AI_DEFAULT_USER_LIMIT=50

# Public API / MCP: requests per minute per API key
API_RATE_LIMIT_PER_MINUTE=120

# Max login/register attempts per minute per IP(+email)
AUTH_RATE_LIMIT_MAX=10

# Web origins allowed to call the API with credentials
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# Feature flags
ENABLE_WORKSPACES=true
ENABLE_COMMENTS=true
ENABLE_PRESENTATIONS=true
ENABLE_AI=true
ENABLE_MCP=false
ENABLE_PPTX_EXPORT=true
