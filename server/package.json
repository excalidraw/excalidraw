    "@fastify/rate-limit": "11.2.0",
    "@fastify/websocket": "11.3.1",
    "dotenv": "16.0.1",
    "fastify": "5.12.5",
    "mongodb": "6.20.0",
    "ws": "8.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.0",
    "tsx": "4.20.6"
  }
}
