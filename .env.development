MODE="development"

# ─────────────────────────────────────────────────────────────────────────────
# Every endpoint below is EMPTY ON PURPOSE.
#
# This fork contacts no Excalidraw-controlled or third-party host by default.
# An unset endpoint means the feature is unavailable — never that it silently
# falls back to a hosted service. See tickets/open/feature-0001-*.
#
# Set these in .env.local (never committed) or, later, in the app's Settings
# surface (feature-0002) to enable the matching feature.
# ─────────────────────────────────────────────────────────────────────────────

# Scene sharing (share links): a read URL and a write URL, both required.
VITE_APP_BACKEND_V2_GET_URL=
VITE_APP_BACKEND_V2_POST_URL=

# The community library: browsing (URL) and publishing (backend) are separate.
VITE_APP_LIBRARY_URL=
VITE_APP_LIBRARY_BACKEND=

# Collaboration WebSocket server (e.g. a local room server on :7312).
VITE_APP_WS_SERVER_URL=

# AI text-to-diagram backend.
VITE_APP_AI_BACKEND=

# Error reporting. Unset = Sentry is never initialised.
VITE_APP_SENTRY_DSN=

# Firebase config for inherited scene/file storage. Unset = that storage is inert.
VITE_APP_FIREBASE_CONFIG=

# ── Local-only defaults ──────────────────────────────────────────────────────

# put these in your .env.local, or make sure you don't commit!
# must be lowercase `true` when turned on
#
# whether to disable live reload / HMR. Usuaully what you want to do when
# debugging Service Workers.
VITE_APP_DEV_DISABLE_LIVE_RELOAD=

# Telemetry is OFF unless explicitly set to "true".
VITE_APP_ENABLE_TRACKING=false

FAST_REFRESH=false

# The port the run the dev server
VITE_APP_PORT=7311

#Debug flags

# To enable bounding box for text containers
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=

# Set this flag to false if you want to open the overlay by default
VITE_APP_COLLAPSE_OVERLAY=true

# Set this flag to false to disable eslint
VITE_APP_ENABLE_ESLINT=true

# Enable the service worker (PWA). OFF by default, and that is deliberate: on a
# tool redeployed by rsync a caching worker serves the OLD bundle after a deploy,
# which reads as "the build did not land". Turning it on is a choice.
VITE_APP_ENABLE_PWA=false

# set to true in .env.development.local to disable the prevent unload dialog
VITE_APP_DISABLE_PREVENT_UNLOAD=

# ── This install's defaults ──────────────────────────────────────────────────
# These SEED Settings on a fresh install ONLY. The moment the operator edits
# anything, the stored settings win and the environment is never consulted
# again. Override per machine in .env.local (never committed) — that is how two
# installs point at two different rails without a line of code changing.
#
# Localhost throughout: self-hosted, so nothing leaves the machine.
VITE_APP_MODEL_BASE_URL=http://127.0.0.1:8080/v1
VITE_APP_MODEL=qwen3.6-35b-a3b-3050@iq2_xxs
VITE_APP_AI_BACKEND=http://127.0.0.1:7313
VITE_APP_COLLAB_SERVER=http://localhost:7312
VITE_APP_TICKETS_API=http://127.0.0.1:7314

# The address ROOM LINKS carry — the host the team reaches. EMPTY on purpose:
# unset means room links point at this machine, which is right for a solo
# session. A deployed install sets this in .env.local (never committed) to the
# hostname its team uses. Any form works: public name, tailnet name, LAN name.
VITE_APP_PUBLIC_URL=

# The VISION route (diagram -> code). "true" only when the bridge has a model
# that can SEE — one launched with an mmproj projector. Left off, the
# Wireframe-to-code entry is HIDDEN rather than offered and then refused: an
# entry that always errors reads as a defect.
VITE_APP_VISION_ENABLED=
