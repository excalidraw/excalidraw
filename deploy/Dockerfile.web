# syntax=docker/dockerfile:1
# Web app (static) + reverse proxy to the API, served by nginx.
#   docker build -f deploy/Dockerfile.web -t excalidraw-workspace-web .

FROM node:22-alpine AS build
WORKDIR /app
COPY . .
RUN --mount=type=cache,target=/usr/local/share/.cache/yarn \
    yarn install --frozen-lockfile --ignore-scripts --network-timeout 600000
RUN yarn --cwd workspace-app build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/workspace-app/build /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s CMD wget -q -O /dev/null http://127.0.0.1/health || exit 1
